    <key>HOME</key><string>@HOME@</string>
    <key>PATH</key><string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:@HOME@/.cargo/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/chuggernaut/dispatcher.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/chuggernaut/dispatcher.log</string>
</dict>
</plist>
