# syntax=docker/dockerfile:1
# Rust agent image for the chuggernaut-on-chuggernaut dogfood project
# (.chug/jobs/code.yaml `image:`): full Rust toolchain, sccache, nats-server and
# the claude CLI. Nothing of this workspace is compiled here — compile reuse is
# the node-local sccache's job alone (worker-provisioned, spec §3.1).
#
# It used to ALSO bake a prebuilt target/ (the warm-target seed, #123/#347), on
# the premise that sccache could not cover the dependency graph. #350 made
# sccache native on arm64 and #352 then measured the two head to head on air
# against the real .chug/tasks/ci.sh command set: seeded 141s vs unseeded-on-a-
# warm-cache 186s. The seed bought 45s per task for 2.26GB in every image, ~600s
# on every worker-refresh leg, and a ~32GB refresh disk peak — while the cache
# it duplicates is 479MB, shared by all four concurrent containers instead of
# copy-on-written per container, and stays warm between deploys instead of going
# stale until the next image rebuild. Deleted; see deploy/prod/README.md.
FROM rust:1.96-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends git openssh-client ripgrep jq ca-certificates curl \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# sccache backs the node-local build cache: when a worker node sets
# WORKER_CACHE_DIR the daemon injects RUSTC_WRAPPER=sccache + SCCACHE_DIR
# (spec §3.1), and cargo reuses compilation across jobs via the shared,
# lock-protected cache dir. Installed from the released binary (a `cargo
# install` here would itself be an uncached cold build). If it is ever absent,
# RUSTC_WRAPPER=sccache degrades to an uncached build rather than failing.
#
# Since #352 deleted the warm-target seed this cache is the ONLY compile reuse
# the image has, so a degraded run is a fully cold one: 275s against 186s warm,
# measured on air with the ci.sh command set. .chug/tasks/ci.sh reports the
# per-run hit rate on every exit and shouts when it is 0%.
#
# The tarball is selected from `dpkg --print-architecture`, never hardcoded
# (deploy #347): the fleet is mixed — gumbo-nuc-0 is amd64, dev-air's colima is
# arm64 — and a foreign-arch sccache does not fail, it runs under qemu as
# RUSTC_WRAPPER for EVERY rustc call. Emulated it is slower than no cache at
# all, and its server can hang on start, which is why .chug/tasks/ci.sh grew a
# liveness probe that disables the wrapper. An unknown arch fails the build
# loudly rather than baking a binary that cannot run.
ARG SCCACHE_VERSION=0.8.2
RUN arch="$(dpkg --print-architecture)" \
 && case "$arch" in \
      amd64) sccache_target=x86_64-unknown-linux-musl ;; \
      arm64) sccache_target=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported build architecture: $arch" >&2; exit 1 ;; \
    esac \
 && curl -fsSL "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-${sccache_target}.tar.gz" \
    | tar -xz -C /tmp \
 && install -m 0755 "/tmp/sccache-v${SCCACHE_VERSION}-${sccache_target}/sccache" /usr/local/bin/sccache \
 && rm -rf "/tmp/sccache-v${SCCACHE_VERSION}-${sccache_target}" \
 && sccache --version

# nats-server binary for tier-2 (NATS) integration tests. A single ~15 MB
# static binary; test-utils' harness spawns it as an ephemeral process (no
# Docker needed) so `.chug/tasks/ci.sh` in this image actually EXECUTES the NATS
# tier instead of silently skipping it (testing.md).
#
# Arch-selected for the same reason as sccache above (deploy #347): this binary
# IS the tier-2 gate on this image, so a qemu-emulated one means the tier the
# gate reports as EXECUTED ran under emulation on every arm64 node.
ARG NATS_VERSION=2.10.22
RUN arch="$(dpkg --print-architecture)" \
 && case "$arch" in \
      amd64) nats_target=linux-amd64 ;; \
      arm64) nats_target=linux-arm64 ;; \
      *) echo "unsupported build architecture: $arch" >&2; exit 1 ;; \
    esac \
 && curl -fsSL "https://github.com/nats-io/nats-server/releases/download/v${NATS_VERSION}/nats-server-v${NATS_VERSION}-${nats_target}.tar.gz" \
    | tar -xz -C /tmp \
 && install -m 0755 "/tmp/nats-server-v${NATS_VERSION}-${nats_target}/nats-server" /usr/local/bin/nats-server \
 && rm -rf "/tmp/nats-server-v${NATS_VERSION}-${nats_target}" \
 && nats-server --version

RUN rustup component add rustfmt clippy \
 && npm install -g @anthropic-ai/claude-code

# ── Where the agent's cargo writes (#352) ────────────────────────────────────
# An EMPTY out-of-tree target dir. Nothing prebuilds it; the point is only that
# it is not inside the git clone. Agents commit from /workspace (spec §4.1), and
# a ~10GB target/ inside the worktree slows `git status` and invites an
# accidental `git add`.
#
# The path must be STABLE across images and containers, and that is not
# cosmetic: sccache's hash covers the target-derived paths cargo passes rustc
# (`-L dependency=$CARGO_TARGET_DIR/debug/deps`), so two containers building the
# same source under two different target paths share nothing. Measured on air
# 2026-07-31, same source and same warm cache, cold target both times: same path
# 100% hits / 22s, different path 0% hits / 54s. A per-job or per-container
# target path would silently turn the node cache off.
ENV CARGO_TARGET_DIR=/opt/chug-cargo-target
RUN mkdir -p /opt/chug-cargo-target

# Headless agents run as root inside a disposable container. Kept for the CLI's
# root checks now that the launch passes `--settings` with a per-role permission
# profile (spec §4.3) instead of `--dangerously-skip-permissions`.
ENV IS_SANDBOX=1

# The clone happens as root at /workspace; commits need an identity.
RUN git config --system user.name "Chuggernaut Agent" \
 && git config --system user.email "agent@chuggernaut.local" \
 && git config --system --add safe.directory '*'

# Image-ownership marker, in the `chug.*` image namespace next to
# `chug.git.sha`. Nothing runs from this image between jobs, so a host-level
# `docker system prune --all` (daily timer on gumbo-nuc-0) deletes it and the
# next job on that node fails to launch with a 404 — the host spares it via
# `--filter label!=chug.managed`.
#
# NOT `chuggernaut.managed` (MANAGED_LABEL, crates/container/src/docker.rs):
# that key marks a job container the dispatcher owns and may reap, and a
# container inherits its image's labels — which is how the worker daemon became
# reapable and the startup sweep killed the fleet on every dispatcher restart
# (#268). deploy/managed-label.test.sh enforces the separation.
#
# Kept LAST: a LABEL is its own layer, so anything above it would be
# invalidated by an edit here.
LABEL chug.managed="true"
