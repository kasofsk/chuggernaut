{
  "name": "chuggernaut-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "codegen": "node scripts/gen-api-types.mjs",
    "codegen:check": "node scripts/gen-api-types.mjs --check",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.6.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.7"
  }
}
